<section class="receipt" aria-labelledby="receipt-heading">
	<h2 id="receipt-heading">Browser receipt</h2>
	<p id="journey-result" aria-live="polite">Checking how this page was reached…</p>
	<ul id="provider-results" aria-label="Provider event results"></ul>
</section>

<script>
	const result = document.querySelector<HTMLParagraphElement>('#journey-result');
	const providerResults = document.querySelector<HTMLUListElement>('#provider-results');
	const stored = sessionStorage.getItem('cwl-starlight-journey-result');
	const providerLabel = (provider: string) => provider === 'fathom'
		? 'Fathom'
		: provider === 'google-analytics'
			? 'Google Analytics 4'
			: provider === 'plausible'
				? 'Plausible'
				: provider === 'matomo' ? 'Matomo' : provider;
	if (!stored) {
		if (result) result.textContent = 'This page was opened directly, so there is no preceding journey-event receipt in this tab.';
	} else {
		try {
			const receipt = JSON.parse(stored) as {
				selectedProvider: string;
				response: {
					ok: boolean;
					providers: Record<string, { ok: boolean; reason?: string }>;
				};
			};
			const selectedLabel = providerLabel(receipt.selectedProvider);
			if (result) result.textContent = `${selectedLabel} accepted the event, so the journey advanced. This pageview is now the next stop.`;
			if (providerResults) {
				for (const [provider, outcome] of Object.entries(receipt.response.providers)) {
					const item = document.createElement('li');
					item.className = outcome.ok ? 'accepted' : 'rejected';
					item.textContent = outcome.ok
						? `${providerLabel(provider)} accepted the event.`
						: `${providerLabel(provider)} did not accept the event (${outcome.reason ?? 'unknown reason'}).`;
					providerResults.append(item);
				}
			}
		} catch {
			if (result) result.textContent = 'The saved journey receipt was unreadable. This destination pageview is still the next stop.';
		}
	}
	sessionStorage.removeItem('cwl-starlight-journey-result');
</script>

<style>
	.receipt { margin-top: 2rem; padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; background: var(--sl-color-gray-7); }
	h2 { margin: 0 0 .8rem; }
	.receipt p { margin: 0; line-height: 1.6; }
	.receipt ul { display: grid; gap: .6rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
	.receipt li { padding: .7rem .8rem; border-radius: .65rem; font-weight: 700; }
	.accepted { color: #bdf8db; background: rgba(29, 157, 103, .16); }
	.rejected { color: #ffd0dc; background: rgba(211, 72, 111, .16); }
</style>
